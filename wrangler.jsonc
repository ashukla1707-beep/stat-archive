{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stat-archive",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEWS",
        "class_name": "ReviewsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "reviews-v1",
      "new_sqlite_classes": ["ReviewsStore"]
    }
  ],
  "main": "worker.js"
}
